# Django settings
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database settings
POSTGRES_DB=optimal_refuel_planner
POSTGRES_USER=optimal_refuel_user
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# RabbitMQ
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Celery
CELERY_BROKER_URL=amqp://guest:guest@rabbitmq:5672//
CELERY_RESULT_BACKEND=django-db

# Fuel Price Scraper
FUEL_PRICE_SOURCE_URL=https://www.cargopedia.net/europe-fuel-prices

# Gunicorn
GUNICORN_WORKERS=3

# Misc
DJANGO_LOG_LEVEL=INFO
DJANGO_ALLOWED_ORIGINS=http://localhost:3000